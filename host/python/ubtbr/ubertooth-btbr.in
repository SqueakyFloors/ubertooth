#!@Python3_EXECUTABLE@
import atexit
import errno
import os
import signal
import subprocess
import sys

# Configured by CMake in the installed wrapper; see specan_ui's matching
# bootstrap. Source-tree execution still works through Python's script dir.
_module_dir = os.path.normpath(os.path.join(
	os.path.dirname(os.path.realpath(__file__)),
	"@PYTHON_PURELIB_FROM_BINDIR@",
))
if os.path.isdir(_module_dir) and _module_dir not in sys.path:
	sys.path.insert(0, _module_dir)

from getopt import getopt, GetoptError
# ubtbr.streams imports nothing outside the standard library, so the whole
# command line can be read -- and -V and -h answered -- up here, ahead of the
# imports further down, which need the Python libusb1 package. -V is the call
# that has to work without it: it is how a user says which tools they have.
from ubtbr.streams import (bin_an_unusable_standard_error, error, eprint,
	flush_the_streams, output_gone, output_lost)

# The options the tool takes, in getopt's form: a ':' marks one that takes a
# value. report_bad_option() reads the same string to find the word a stray
# dash came from, so there is one copy for the two of them.
SHORT_OPTIONS = "f:b:U:hV"

USAGE = ("Usage: ubertooth-btbr [-U <index|serial>] [-f <freq_offset>] "
	"[-b <max_ac_errors>]\n"
	"Options:\n"
	"  -U <index|serial>: select Ubertooth by index or serial; "
	"see ubertooth(7)\n"
	"  -f freq_offset: Set MOD_OFFSET register\n"
	"  -b max_ac_errors: Max bit errors in Syncword detection\n"
	"  -V: print version information: the host tools, and the\n"
	"      firmware version and build of each attached board\n"
	"  -h: print this help\n")

# The tool that prints the -V answer. One function in libubertooth builds that
# answer and ubertooth-util prints it, so running it here passes the same
# lines on rather than writing a second version of them in Python, which
# would then have to be kept in step by hand. The host tools and this tool are
# installed together, so it is the answer the user would get from
# ubertooth-util themselves. ubertooth(7), COMMON OPTIONS, has the lines.
VERSION_TOOL = "ubertooth-util"

def usage():
	"""The usage text for -h, on standard output."""
	try:
		sys.stdout.write(USAGE)
	except (AttributeError, ValueError):
		# There is no standard output to write to: a descriptor closed
		# before the tool started leaves the interpreter without one. The
		# text was asked for and has nowhere to go, which is the same loss
		# as a reader that went away, so it is reported the same way and
		# leaves the command exit 1.
		output_lost()

def report_versions(selector=None):
	"""Print the -V answer, and return the exit status it leaves behind.

	The child writes to this tool's own streams, so each line lands on the
	stream it belongs on and in the order the child wrote them, and a board
	it could not read is reported there exactly as the C tools report it.
	"""
	command = [VERSION_TOOL, "-V"]
	if selector is not None:
		# The board -U named, as ubertooth-util's own -U names it, whatever
		# it was given: what an empty value means is that tool's to say, as
		# it is for the session this tool opens without -V.
		command += ["-U", selector]
	# Nothing of this tool's is waiting in the buffers here, and this keeps
	# it that way: a line written before the child starts must not land
	# after the child's.
	try:
		sys.stdout.flush()
	except (AttributeError, ValueError):
		# There is no standard output at all: a descriptor closed before the
		# tool started leaves the interpreter without one, so the answer
		# cannot be printed. Reported as the loss it is, and the child is
		# not started: with that descriptor closed, the first file the child
		# opens takes its number, and the answer would be written into
		# whatever that turned out to be.
		output_lost()
		return 1
	child_streams = {}
	try:
		sys.stderr.flush()
	except (AttributeError, ValueError):
		# Nor any standard error. That costs the child's diagnostics and not
		# the answer, so nothing is said about it, but the child is handed
		# the bin for them rather than the closed descriptor: the first file
		# it opened would otherwise take that number and its lines would be
		# written into whatever that turned out to be.
		child_streams["stderr"] = subprocess.DEVNULL
	try:
		status = subprocess.call(command, **child_streams)
	except OSError as e:
		# Not on the PATH, or there and not executable. Reported in one line
		# like every other failure here, rather than ending the tool in a
		# traceback.
		error("could not run %s: %s"%(VERSION_TOOL, e.strerror or e))
		return 1
	# ubertooth-util exits 0 with the whole answer and 1 when part of it could
	# not be read; a child killed by a signal (a negative status here)
	# answered nothing at all.
	return 0 if status == 0 else 1

def dash_word(words, short_options):
	"""The option word a stray '-' came from, as the user wrote it.

	getopt reports the letter it rejected and not the word it was in, so the
	word is found by asking getopt again, one word longer each time: the
	first command line that ends in a rejected '-' ends in the word that
	holds it. Another refusal on the way (a missing value the next word will
	supply) is not it. None means no word produced one, which leaves the
	caller to name the dash alone.
	"""
	for length in range(1, len(words) + 1):
		try:
			getopt(words[:length], short_options)
		except GetoptError as refusal:
			if refusal.opt == '-':
				return words[length - 1]
	return None

def report_bad_option(refusal, short_options):
	"""Report a command line getopt would not take, as the other tools do.

	One line naming what is wrong, and no usage text: the user can run -h.
	getopt's own messages name the option but not what the tools call the
	problem, so they are rewritten here.
	"""
	# getopt says "option --name ..." for a word starting with two dashes
	# and "option -c ..." for a single letter. No tool takes long options.
	long_option = refusal.msg.startswith("option --")
	# A stray dash in an option word ("-h-") is rejected as the letter '-',
	# which reads as a long option here, so it is taken first: the word the
	# user wrote is what names it, as in the C tools.
	dash = (dash_word(sys.argv[1:], short_options)
		if refusal.opt == '-' else None)
	if refusal.msg.endswith("requires argument"):
		error("option '-%s' requires a value"%refusal.opt)
	elif refusal.opt == '-':
		error("unrecognized option '-' in '%s'"%dash if dash
			else "unrecognized option '-'")
	elif long_option:
		error("unrecognized option '--%s': the tools take "
			"single-letter options"%refusal.opt)
	else:
		error("unrecognized option '-%s'"%refusal.opt)
	sys.exit(1)

def read_command_line():
	"""Read the command line, and return the board and settings for a session.

	Ends the command where that is the whole answer: -V, -h, and a command
	line the tool will not take. Returns (board, settings) otherwise, where
	settings are the (option, value) pairs to send once the board is open.
	"""
	try:
		opt, args = getopt(sys.argv[1:], SHORT_OPTIONS)
	except GetoptError as e:
		report_bad_option(e, SHORT_OPTIONS)

	# Read before the device is opened, so a command line that is wrong is
	# refused without touching a board, and says what is wrong with it rather
	# than reporting whatever the board did first.
	# Both go into a request as 16 bits, so a value outside that is refused
	# here rather than reaching the packing and raising from there.
	settings = []
	selectors = []
	help_wanted = False
	version_wanted = False
	for o, v in opt:
		if o == '-h':
			# Takes effect once the whole command line has parsed, as in the
			# other tools, so a bad value or a stray word is still reported.
			help_wanted = True
			continue
		if o == '-V':
			# Deferred for the same reason as -h.
			version_wanted = True
			continue
		if o == '-U':
			# Checked for repeats below, where the other tools check theirs.
			selectors.append(v)
			continue
		try:
			value = int(v)
		except ValueError:
			value = None
		if value is None or value < 0 or value > 0xffff:
			error("%s must be 0-65535 (got %s)"%(o, v))
			sys.exit(1)
		settings.append((o, value))
	if args:
		error("unexpected argument '%s'"%args[0])
		sys.exit(1)

	# An option given a value twice is two answers to one question, and the
	# tool does not pick between them. The wording is the one every tool
	# uses, from opt_check_once() in the C tools. Checked before -h ends the
	# command, like the other faults above: the C tools refuse the repeat as
	# they read the command line, so -h does not excuse it there either.
	given = ['-U'] * len(selectors) + [o for o, value in settings]
	for o in ('-U', '-f', '-b'):
		if given.count(o) > 1:
			error("option '%s' given more than once"%o)
			sys.exit(1)
	selector = selectors[0] if selectors else None

	# -V and -h both end the command, and both answer on standard output, so
	# a command line with both prints both: the version first and the usage
	# text last, so the shorter answer is not scrolled off the screen by it,
	# whichever order they were written in. The status is the version's: -h
	# has none of its own.
	if version_wanted or help_wanted:
		status = report_versions(selector) if version_wanted else 0
		if help_wanted:
			usage()
		sys.exit(status)

	return selector, settings

def through(stage):
	"""Run one stage of the tool, and report a standard output that went away.

	Both stages come through here: the command line, which answers -V and -h
	ahead of the imports below, and the session. Either can find the stream
	gone -- `ubertooth-btbr -h | head -0` is the first -- and the interpreter
	flushes it as it exits, outside any handler, where a failed flush ends
	the tool in status 120 and a message of its own.

	Returns what the stage returned. A stage that ended the command, through
	sys.exit() or a stream that went away, does not return.
	"""
	status = 0
	try:
		return stage()
	except SystemExit as leaving:
		status = leaving.code or 0
	except BrokenPipeError:
		# A write that was not a packet: the usage text goes to standard
		# output too, and result() is the only one that notices the stream
		# going away by itself. A command line the tool refuses is the
		# reachable case, since it writes before anything else does. A
		# failed write to standard error from either stage arrives here as
		# well and is reported as this; everything the prompt writes -- the
		# intro, the prompt itself, and what `?` prints -- goes through
		# BTCtlPrompt.say(), so a standard error nobody reads does not cost
		# the capture.
		output_lost()
		# Out without the interpreter's own teardown, for the reason the
		# command that would not stop takes that way out: once a session is
		# running, the receive thread may be inside libusb, and taking the
		# library down under it is what turns an exit into an abort. The
		# command-line stage has no such thread, and leaves the same way so
		# that both stages report a lost stream alike. Whatever is still
		# buffered for the stream that failed goes with it, which is where
		# it was headed.
		sys.stderr.flush()
		os._exit(1)
	finally:
		# The last word on that stream, while a handler can still reach the
		# failure: the interpreter flushes it as it exits, outside any
		# handler, and a flush that fails there ends the tool in status 120
		# and a message of its own. Under `finally`, so that an exception on
		# the way out of the stage does not leave that flush to the
		# interpreter.
		try:
			sys.stdout.flush()
		except BrokenPipeError:
			output_lost()
		except (AttributeError, ValueError):
			# There is no standard output to flush: a descriptor closed
			# before the tool started leaves the interpreter without one.
			pass
		except OSError as problem:
			# The other face of a descriptor closed before the tool
			# started: most interpreters leave the tool without the stream,
			# which the handler above catches, and some leave the stream and
			# a descriptor whose every write fails with EBADF. The usage
			# text reaches the buffer either way, so this flush is where
			# that one shows up. Any other OSError is a failure of its own
			# and is left to be raised.
			if problem.errno != errno.EBADF:
				raise
			output_lost()
	# A standard output that went away means what was asked for was not all
	# printed, whatever the stage made of the rest.
	sys.exit(1 if output_gone() else status)

if __name__ == '__main__':
	# Before anything is printed, since what this does is decide where the
	# diagnostics below go.
	bin_an_unusable_standard_error()
	# The last word on both streams, and the only handler the flush as the
	# interpreter exits can be kept out of.
	atexit.register(flush_the_streams)

	# Read here, ahead of the imports below, so that -V, -h and a refused
	# command line are answered on a host without the Python libusb1 package.
	COMMAND_LINE = through(read_command_line)

# What a session needs, and -V and -h above do not: usb1 comes from the
# Python libusb1 package, and ubtbr.btctl imports it as well.
try:
	import usb1
	from cmd import Cmd
	from ubtbr.btctl import *
except ImportError as missing:
	# Reported in one line, like every other failure here, rather than
	# ending the tool in a traceback. Nothing below is defined, since the
	# exit leaves this module part way through.
	error("could not start the session: %s"%missing)
	# Where to get it, for the module that comes from a package the user
	# installs. Any other name missing here is a broken install, and
	# telling that user to install libusb1 would send them the wrong way.
	if missing.name == "usb1":
		eprint("note: a session needs the Python libusb1 package, which "
			"ships the usb1 module; install it with "
			"\"pip install libusb1\"\n")
	sys.exit(1)

class BTCtlL2Ping(BTCtlPagingCmd):
	def __init__(self, bt, bdaddr):
		super().__init__(bt, bdaddr)
		self._l2cap_command_id = 0xc8

	def _send_l2cap_echo_req(self, data=b"ECHO"):
		echo_req = (p8(8)	# command code 2: echo req
			+p8(self._l2cap_command_id)
			+p16(len(data))	# command length
			+data)
		pdu = (p16(len(echo_req))
			+ p16(1)	# cid l2cap sig channel
			+ echo_req)
		
		self.send_acl(LLID_L2CAP_START, pdu)

		self._l2cap_command_id += 1
		if self._l2cap_command_id > 0xff:
			self._l2cap_command_id = 0xc8

	def handle_setup_complete(self):
		log.info("LMP setup complete")
		# send dummy l2cap packet
		self._send_l2cap_echo_req()

	def _handle_l2cap(self, pkt):
		acl = pkt.bt_data
		result("RX L2CAP: %s"%acl)
		self._send_l2cap_echo_req()

class PromptNotes:
	"""Standard error, as a stream for Cmd to write the prompt's own text to.

	Cmd writes what `?` and `? <command>` print through its `stdout`
	attribute. That text is the tool describing itself, not capture data, so
	it belongs with the prompt on standard error. Writes go through
	BTCtlPrompt.say(), so a standard error nobody reads costs a note and not
	the capture.

	Cmd writes a command list in several pieces, so a progress line from a
	running command can land in the middle of one. The prompt and the
	progress lines already interleave on this stream the same way, and no
	line of a capture is at stake: the capture is on standard output.
	"""

	def __init__(self, prompt):
		self._prompt = prompt

	def write(self, text):
		self._prompt.say(text)

	def flush(self):
		# Nothing to do: say() flushes each write as it makes it. A stream
		# handed to Cmd has to offer this, which is the only reason it is
		# here.
		pass

class BTCtlPrompt(Cmd):
	# Standard output carries the capture: one packet to a line, each with
	# the time it was printed in front of it. The prompt is the tool saying
	# it is ready, which is a note and not capture data, and it carries no
	# newline of its own, so on that stream it lands on the front of the
	# next packet and no line can be read by its time.
	#
	# The intro line therefore always goes to standard error, and so does the
	# prompt unless a terminal's line editor is drawing it; __init__ below
	# decides which. Cmd's own prompt is empty until it is handed one there.
	# What `?` prints goes to standard error as well, through the stream
	# __init__ hands Cmd: every line of standard output is then a packet,
	# whatever the user types during a capture.
	prompt = ""
	PROMPT = "bt> "
	intro = "Type ? to list commands"
	# A topic there is no help for is a request the tool cannot answer, so it
	# reads like every other refusal the prompt gives, in place of Cmd's own
	# "*** No help on <topic>". Cmd interpolates this and writes it itself,
	# which is why the `error: ` of btctl's error() is spelled out here; the
	# write goes through say() with the rest of what the prompt says, so a
	# standard error nobody reads costs the line and not the capture.
	nohelp = "error: no help on '%s'"

	def __init__(self, bt):
		self._bt = bt
		self._cmd = None
		self._gave_up = False
		self._abandoned = False
		super().__init__(stdout=PromptNotes(self))
		# Who writes the prompt. Cmd hands its prompt to the terminal's line
		# editor, which both draws it and counts its width when it redraws
		# the line being edited: an editor that does not know the prompt is
		# there puts the cursor four columns out when the user presses
		# Ctrl-A, and clears it off the screen on Ctrl-L. That editor runs
		# only when standard input and standard output are both a terminal,
		# and then standard error is that same terminal, so the user sees
		# the prompt wherever it was written. So there, Cmd keeps it.
		#
		# Otherwise standard output is a stream somebody is reading, Cmd
		# would write the prompt into it, and no line editor is involved: the
		# prompt goes to standard error through say_prompt() below.
		self._editor_draws_prompt = sys.stdin.isatty() and sys.stdout.isatty()
		if self._editor_draws_prompt:
			self.prompt = self.PROMPT

	def say(self, text):
		"""Write a note to standard error, giving up on a stream nobody reads.

		The capture is on standard output and must not be lost because
		nobody is reading the notes: a write that raised from here would
		leave the prompt loop and be reported as standard output going away.
		"""
		try:
			eprint(text)
		except BrokenPipeError:
			point_at_the_bin(sys.stderr)
		except (AttributeError, ValueError):
			# There is no standard error to write to: a descriptor closed
			# before the tool started leaves the interpreter without one.
			# Nothing is written to it either way, which is how
			# output_lost() and the last flush treat the same case.
			pass

	def say_prompt(self):
		"""The prompt, where the line editor is not the one drawing it."""
		if not self._editor_draws_prompt:
			self.say(self.PROMPT)

	def _parse_bdaddr(self, inp):
		bdaddr = None
		try:
			bdaddr = int(inp.replace(":",""),16)
		except:
			pass
		if bdaddr is None or bdaddr < 0 or bdaddr >= (1<<48):
			# A diagnostic, so not on standard output.
			error("BD_ADDR must be xx:xx:xx:xx:xx:xx (got %s)"%inp)
		else:
			return bdaddr

	def start_cmd(self, cls, *args):
		if self._cmd is not None and (self._cmd.done() or self._gave_up):
			self.stop_cmd()
		if self._cmd is not None:
			# Either it is still running, or it outlived its stop and still
			# holds the message handler a new command would claim.
			log.info ("Not idle")
			return

		log.info("Starting %s"%cls.__name__)
		args = [self._bt]+list(args)
		# Claiming the message handler is what can still refuse here, and it
		# raises: nothing is assigned, so the prompt is left as it was and
		# onecmd reports it.
		#
		# Starting a command takes three steps, and a Ctrl-C used to be able
		# to land between any two of them: building the command claims the
		# device's one message handler, its thread is what releases that
		# handler again, and the assignment is what gives the prompt the
		# handle its stop needs. Interrupted part way, the prompt held
		# nothing while the device stayed claimed, or held a thread that
		# never ran, which cannot be joined: that RuntimeError came out of
		# main() as a traceback. So the interrupt is only noted while the
		# three steps run, and raised below once they are all done, where it
		# is the ordinary Ctrl-C with a command running that the prompt's
		# handler knows how to stop. Nothing here waits on the device -- the
		# command's first request goes out on its own thread -- so the
		# interrupt waits a few instructions at most. This runs on the
		# prompt's own thread, which is where an interrupt arrives and the
		# only thread a handler can be installed from.
		interrupted = False

		def note_interrupt(signum, frame):
			nonlocal interrupted
			interrupted = True

		previous = signal.signal(signal.SIGINT, note_interrupt)
		try:
			cmd = cls(*args)
			try:
				cmd.start()
			except RuntimeError as e:
				# The interpreter can refuse a new thread, and that thread
				# is what gives back the message handler the command claimed
				# as it was built. Nothing holds the command now, so
				# release() hands the claim back; left claimed, the board
				# stays taken and every later command is refused as still
				# running. Reported like any other command that could not
				# run, so the user is left at the prompt and not in a
				# traceback. A Ctrl-C noted above is dropped with it, which
				# costs nothing: it would have stopped the command that is
				# not running.
				cmd.release()
				raise BTCtlError("could not start the command: %s"%e)
			self._cmd = cmd
		finally:
			signal.signal(signal.SIGINT, previous)
		if interrupted:
			raise KeyboardInterrupt
		return self._cmd

	def stop_cmd(self):
		if self._cmd is None:
			return
		if self._gave_up:
			# It already outlived one stop. Asking again would only spend
			# another join on it, but if it has ended since, the session gets
			# its device back instead of refusing every later command.
			if self._cmd.is_alive():
				return
			self._cmd = None
			self._gave_up = False
			return
		self._cmd.stop()
		self._cmd.join(self._cmd.JOIN_TIMEOUT)
		if self._cmd.is_alive():
			# Keep the handle: start_cmd then refuses to start another rather
			# than tripping over the one still holding the message handler.
			# The prompt itself stays usable, and exiting is never blocked by
			# it.
			error("%s did not stop"%self._cmd)
			self._gave_up = True
			return
		self._cmd = None

	def preloop(self):
		"""The prompt for the first command, before Cmd reads it."""
		self.say_prompt()

	def postcmd(self, stop, line):
		"""The prompt for the next command.

		Cmd reads one command per turn of its loop and calls this last, so
		one prompt is written per command read. None after the command that
		ends the session.
		"""
		if not stop:
			self.say_prompt()
		return stop

	def cmdloop(self, intro=None):
		self.say(self.intro + "\n")
		while True:
			try:
				super().cmdloop(intro="")
				break
			except KeyboardInterrupt:
				try:
					self.do_idle()
				except KeyboardInterrupt:
					# A second Ctrl-C while the command is being stopped
					# returns to the prompt instead of ending the tool
					# somewhere in the middle of the stop.
					pass

	def onecmd(self, line):
		try:
			return super().onecmd(line)
		except (usb1.USBError, BTCtlError) as e:
			# A request the board no longer takes, or a command that outlived
			# its stop and still owns the messages, ends that command and not
			# the session: the prompt is where the user gets to try again or
			# leave. A command that runs commands of its own reaches the
			# second case, since it can give up on a child and then end
			# cleanly itself, leaving the child holding the handler.
			error("%s: %s"%(line, e))

	def default(self, inp):
		# The command name, which is all that names a command: `exit` has a
		# handler of its own and Cmd hands it whatever followed, so these
		# two short spellings of leaving read the line the same way.
		command = inp.split(None, 1)[0]
		if command in ('x','q'):
			return self.do_exit(inp)
		# A word the prompt does not know is a request it cannot answer, so
		# it reads like the prompt's other refusals rather than being taken
		# silently, and rather than Cmd's own "*** Unknown syntax". A
		# command name is not a command line: the session carries on at the
		# prompt and its exit status is unchanged. Written through say()
		# with the rest of what the prompt says, so a standard error nobody
		# reads costs the line and not the capture.
		self.say("error: no such command '%s'\n"%command)

	def do_exit(self, inp):
		# Stopped first: a command still running would be left writing to a
		# device the close below took away.
		self.stop_cmd()
		if self._cmd is not None:
			error("leaving the device open: %s is still running"
				%self._cmd)
			self._abandoned = True
		elif not self._bt.close():
			# close() has said what it kept the device open for: a command
			# this prompt had already let go of, or a receive thread still
			# inside libusb.
			self._abandoned = True
		return True

	def abandoned(self):
		"""Whether the session ended with the device still claimed."""
		return self._abandoned

	# What `? <command>` prints for each command, in the form Cmd looks for.
	# Cmd gives these no argument and collects nothing from them: each writes
	# its own line, through the `stdout` attribute __init__ pointed at
	# standard error, so `?` and `? <command>` leave by the one way out.

	def help_exit(self):
		self.stdout.write("Exit the application\n")

	def do_page(self, inp):
		bdaddr = self._parse_bdaddr(inp)
		if bdaddr is not None:
			self.start_cmd(BTCtlPagingCmd, bdaddr)
		
	def help_page(self):
		self.stdout.write("page <BD_ADDR>: Establish connection with given device\n")

	def do_inquiry(self, inp):
		self.start_cmd(BTCtlInquiryCmd)

	def help_inquiry(self):
		self.stdout.write("inquiry: Discover nearby devices\n")

	def do_inquiry_scan(self, inp):
		self.start_cmd(BTCtlInquiryScanCmd)

	def help_inquiry_scan(self):
		self.stdout.write("inquiry_scan: Become visible to nearby devices\n")

	def do_page_scan(self, inp):
		self.start_cmd(BTCtlPageScanCmd)

	def help_page_scan(self):
		self.stdout.write("page_scan: Become connectable to nearby devices\n")

	def do_discoverable(self, inp):
		self.start_cmd(BTCtlDiscoverableCmd)

	def help_discoverable(self):
		self.stdout.write("discoverable: Become visible and connectable"
			" to nearby devices\n")

	def do_idle(self, inp=None):
		self.stop_cmd()

	def help_idle(self):
		self.stdout.write("idle: Stop current operation and go standby\n")

	def do_bdaddr(self, inp):
		bdaddr = self._parse_bdaddr(inp)
		if bdaddr is not None:
			self._bt.send_set_bdaddr_cmd(bdaddr)

	def help_bdaddr(self):
		self.stdout.write("bdaddr <BD_ADDR>: Set device bluetooth address\n")

	def do_l2ping(self, inp):
		bdaddr = self._parse_bdaddr(inp)
		if bdaddr is not None:
			self.start_cmd(BTCtlL2Ping, bdaddr)

	def help_l2ping(self):
		self.stdout.write("l2ping <BD_ADDR>: Page given device and perform l2ping\n")

	def do_monitor(self, inp):
		slave_bdaddr = self._parse_bdaddr(inp)
		if slave_bdaddr is not None:
			self.start_cmd(BTCtlMonitorCmd, slave_bdaddr)
		
	def help_monitor(self):
		self.stdout.write("monitor <SLAVE_BD_ADDR>: Sniff connection"
			" establishment to given device\n")

	def emptyline(self):
		pass

	do_EOF = do_exit
	help_EOF = help_exit

def leave(bt, status):
	"""Exit with no thread left inside libusb.

	The receive thread is a daemon, so the interpreter will not wait for it,
	and taking libusb down while that thread is inside a bulk read is how an
	exit becomes an abort. Stopping it first costs one read timeout. A thread
	that will not come out is reported by close(), which then leaves the
	handle alone.
	"""
	if bt is not None and bt.connected():
		bt.close()
	sys.exit(status)

def main(selector, settings):
	"""Run a session on the board the command line named.

	`settings` are the (option, value) pairs read from the command line that
	are sent to the board once it is open.
	"""
	if sys.stdout is None:
		# A session needs this stream twice over: the capture is printed to
		# it, and the interpreter's own input() refuses to read a line
		# without it. A descriptor closed before the tool started leaves it
		# missing, so the session is refused here, before any board is
		# opened, rather than ending in a traceback once the prompt first
		# reads. Standard error closed is the same rule of the
		# interpreter's, and there not even the line can be said.
		output_lost()
		return
	bt = None
	try:
		bt = BTCtl.find(selector)
		bt.connect()

		for o, value in settings:
			if o == '-f':
				bt.send_set_freq_off_cmd(value)
			elif o == '-b':
				bt.send_set_max_ac_errors_cmd(value)

		bt.send_set_bdaddr_cmd(0x112233445566)
		eir = BTCtlEIR([
			(BTCtlEIR.EIR_COMPLETE_LOCAL_NAME, b"Ubertooth"),
		])
		bt.send_set_eir_cmd(eir.pack())
		sleep(0.02)
	except BTCtlNoDeviceError as e:
		error(e)
		sys.exit(1)
	except (usb1.USBError, BTCtlError) as e:
		# A board running firmware other than ubtbr takes none of this, and
		# used to leave the tool waiting on the write forever.
		#
		# Named by serial, because the usual cause is the wrong board rather
		# than a bad one: the serial says which board the session got, which
		# the user can compare with the one they flashed btbr onto.
		error("could not set up %s: %s"%(bt.board(), e))
		if isinstance(e, usb1.USBErrorTimeout):
			# The bluetooth_rxtx firmware offers the endpoint this tool
			# writes to but never reads it, so a request sits there until the
			# write times out. That is what every report of the tool hanging
			# shortly after start has turned out to be. A board already
			# carrying btbr that stopped answering times out the same way,
			# which is why this names what that firmware does rather than
			# telling the user what their board has.
			eprint("note: a board carrying bluetooth_rxtx never reads these "
				"requests; flash btbr with "
				"ubertooth-dfu -d firmware/btbr/btbr.dfu -r\n")
		leave(bt, 1)
	except KeyboardInterrupt:
		# Interrupted anywhere before the prompt was up, which is the window
		# the hang shortly after start lives in.
		leave(bt, 1)
	prompt = BTCtlPrompt(bt)
	prompt.cmdloop()
	if prompt.abandoned():
		# The session ended with the device still claimed by a command that
		# would not stop, so it did not do all it was asked. Out without the
		# interpreter's own teardown: that command may still be inside
		# libusb, and taking the library down under it is what turns an exit
		# into an abort. Nothing is buffered past the flushes.
		sys.stdout.flush()
		sys.stderr.flush()
		os._exit(1)
	if bt.rx_error() is not None:
		# The thread reading the board stopped on a failure: the board left
		# the bus, stopped answering, or sent something the framing could
		# not read. Nothing restarts that thread, so no message has arrived
		# since. Whatever the commands after that printed, the session did
		# not do what it was asked, so a script wrapping this tool can tell
		# it from one where every command worked. The handle closed cleanly,
		# which is why this is an ordinary exit.
		#
		# A command the board answered with a refusal is not this: that is
		# one command failing in a session that went on working, the way a
		# shell reports a failed command without failing itself.
		sys.exit(1)

if __name__ == '__main__':
	through(lambda: main(*COMMAND_LINE))
	# The session ended without asking for a status of its own, so all that
	# is left to say is whether standard output was there to the end.
	sys.exit(1 if output_gone() else 0)
