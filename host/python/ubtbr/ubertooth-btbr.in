#!@Python3_EXECUTABLE@
import os
import signal
import sys

# Configured by CMake in the installed wrapper; see specan_ui's matching
# bootstrap. Source-tree execution still works through Python's script dir.
_module_dir = os.path.normpath(os.path.join(
	os.path.dirname(os.path.realpath(__file__)),
	"@PYTHON_PURELIB_FROM_BINDIR@",
))
if os.path.isdir(_module_dir) and _module_dir not in sys.path:
	sys.path.insert(0, _module_dir)

import usb1
from cmd import Cmd
from ubtbr.btctl import *
from getopt import getopt, GetoptError

class BTCtlL2Ping(BTCtlPagingCmd):
	def __init__(self, bt, bdaddr):
		super().__init__(bt, bdaddr)
		self._l2cap_command_id = 0xc8

	def _send_l2cap_echo_req(self, data=b"ECHO"):
		echo_req = (p8(8)	# command code 2: echo req
			+p8(self._l2cap_command_id)
			+p16(len(data))	# command length
			+data)
		pdu = (p16(len(echo_req))
			+ p16(1)	# cid l2cap sig channel
			+ echo_req)
		
		self.send_acl(LLID_L2CAP_START, pdu)

		self._l2cap_command_id += 1
		if self._l2cap_command_id > 0xff:
			self._l2cap_command_id = 0xc8

	def handle_setup_complete(self):
		log.info("LMP setup complete")
		# send dummy l2cap packet
		self._send_l2cap_echo_req()

	def _handle_l2cap(self, pkt):
		acl = pkt.bt_data
		result("RX L2CAP: %s"%acl)
		self._send_l2cap_echo_req()

class BTCtlPrompt(Cmd):
	prompt = "bt> "
	intro = "Type ? to list commands"

	def __init__(self, bt):
		self._bt = bt
		self._cmd = None
		self._gave_up = False
		self._abandoned = False
		super().__init__()

	def _parse_bdaddr(self, inp):
		bdaddr = None
		try:
			bdaddr = int(inp.replace(":",""),16)
		except:
			pass
		if bdaddr is None or bdaddr < 0 or bdaddr >= (1<<48):
			# A diagnostic, so not on standard output.
			error("BD_ADDR must be xx:xx:xx:xx:xx:xx (got %s)"%inp)
		else:
			return bdaddr

	def start_cmd(self, cls, *args):
		if self._cmd is not None and (self._cmd.done() or self._gave_up):
			self.stop_cmd()
		if self._cmd is not None:
			# Either it is still running, or it outlived its stop and still
			# holds the message handler a new command would claim.
			log.info ("Not idle")
			return

		log.info("Starting %s"%cls.__name__)
		args = [self._bt]+list(args)
		# Claiming the message handler is what can still refuse here, and it
		# raises: nothing is assigned, so the prompt is left as it was and
		# onecmd reports it.
		#
		# Starting a command takes three steps, and a Ctrl-C used to be able
		# to land between any two of them: building the command claims the
		# device's one message handler, its thread is what releases that
		# handler again, and the assignment is what gives the prompt the
		# handle its stop needs. Interrupted part way, the prompt held
		# nothing while the device stayed claimed, or held a thread that
		# never ran, which cannot be joined: that RuntimeError came out of
		# main() as a traceback. So the interrupt is only noted while the
		# three steps run, and raised below once they are all done, where it
		# is the ordinary Ctrl-C with a command running that the prompt's
		# handler knows how to stop. Nothing here waits on the device -- the
		# command's first request goes out on its own thread -- so the
		# interrupt waits a few instructions at most. This runs on the
		# prompt's own thread, which is where an interrupt arrives and the
		# only thread a handler can be installed from.
		interrupted = False

		def note_interrupt(signum, frame):
			nonlocal interrupted
			interrupted = True

		previous = signal.signal(signal.SIGINT, note_interrupt)
		try:
			cmd = cls(*args)
			try:
				cmd.start()
			except RuntimeError as e:
				# The interpreter can refuse a new thread, and that thread
				# is what gives back the message handler the command claimed
				# as it was built. Nothing holds the command now, so
				# release() hands the claim back; left claimed, the board
				# stays taken and every later command is refused as still
				# running. Reported like any other command that could not
				# run, so the user is left at the prompt and not in a
				# traceback. A Ctrl-C noted above is dropped with it, which
				# costs nothing: it would have stopped the command that is
				# not running.
				cmd.release()
				raise BTCtlError("could not start the command: %s"%e)
			self._cmd = cmd
		finally:
			signal.signal(signal.SIGINT, previous)
		if interrupted:
			raise KeyboardInterrupt
		return self._cmd

	def stop_cmd(self):
		if self._cmd is None:
			return
		if self._gave_up:
			# It already outlived one stop. Asking again would only spend
			# another join on it, but if it has ended since, the session gets
			# its device back instead of refusing every later command.
			if self._cmd.is_alive():
				return
			self._cmd = None
			self._gave_up = False
			return
		self._cmd.stop()
		self._cmd.join(self._cmd.JOIN_TIMEOUT)
		if self._cmd.is_alive():
			# Keep the handle: start_cmd then refuses to start another rather
			# than tripping over the one still holding the message handler.
			# The prompt itself stays usable, and exiting is never blocked by
			# it.
			error("%s did not stop"%self._cmd)
			self._gave_up = True
			return
		self._cmd = None

	def cmdloop(self, intro=None):
		print(self.intro)
		while True:
			try:
				super().cmdloop(intro="")
				break
			except KeyboardInterrupt:
				try:
					self.do_idle()
				except KeyboardInterrupt:
					# A second Ctrl-C while the command is being stopped
					# returns to the prompt instead of ending the tool
					# somewhere in the middle of the stop.
					pass

	def onecmd(self, line):
		try:
			return super().onecmd(line)
		except (usb1.USBError, BTCtlError) as e:
			# A request the board no longer takes, or a command that outlived
			# its stop and still owns the messages, ends that command and not
			# the session: the prompt is where the user gets to try again or
			# leave. A command that runs commands of its own reaches the
			# second case, since it can give up on a child and then end
			# cleanly itself, leaving the child holding the handler.
			error("%s: %s"%(line, e))

	def default(self, inp):
		if inp in ('x','q'):
			return self.do_exit(inp)

	def do_exit(self, inp):
		# Stopped first: a command still running would be left writing to a
		# device the close below took away.
		self.stop_cmd()
		if self._cmd is not None:
			error("leaving the device open: %s is still running"
				%self._cmd)
			self._abandoned = True
		elif not self._bt.close():
			# close() has said what it kept the device open for: a command
			# this prompt had already let go of, or a receive thread still
			# inside libusb.
			self._abandoned = True
		return True

	def abandoned(self):
		"""Whether the session ended with the device still claimed."""
		return self._abandoned

	def help_exit(self):
		print("Exit the application")

	def do_page(self, inp):
		bdaddr = self._parse_bdaddr(inp)
		if bdaddr is not None:
			self.start_cmd(BTCtlPagingCmd, bdaddr)
		
	def help_page(self):
		print ("page <BD_ADDR>: Establish connection with given device")

	def do_inquiry(self, inp):
		self.start_cmd(BTCtlInquiryCmd)

	def help_inquiry(self):
		print("inquiry: Discover nearby devices")

	def do_inquiry_scan(self, inp):
		self.start_cmd(BTCtlInquiryScanCmd)

	def help_inquiry_scan(self):
		print("inquiry_scan: Become visible to nearby devices")

	def do_page_scan(self, inp):
		self.start_cmd(BTCtlPageScanCmd)

	def help_page_scan(self):
		print("page_scan: Become connectable to nearby devices")

	def do_discoverable(self, inp):
		self.start_cmd(BTCtlDiscoverableCmd)

	def help_discoverable(self):
		print("discoverable: Become visible and connectable to nearby devices")

	def do_idle(self, inp=None):
		self.stop_cmd()

	def help_idle(self):
		print ("idle: Stop current operation and go standby")

	def do_bdaddr(self, inp):
		bdaddr = self._parse_bdaddr(inp)
		if bdaddr is not None:
			self._bt.send_set_bdaddr_cmd(bdaddr)

	def help_bdaddr(self):
		print("bdaddr <BD_ADDR>: Set device bluetooth address")

	def do_l2ping(self, inp):
		bdaddr = self._parse_bdaddr(inp)
		if bdaddr is not None:
			self.start_cmd(BTCtlL2Ping, bdaddr)

	def help_l2ping(self):
		print("l2ping <BD_ADDR>: Page given device and perform l2ping")

	def do_monitor(self, inp):
		slave_bdaddr = self._parse_bdaddr(inp)
		if slave_bdaddr is not None:
			self.start_cmd(BTCtlMonitorCmd, slave_bdaddr)
		
	def help_monitor(self):
		print ("monitor <SLAVE_BD_ADDR>: Sniff connection establishment to given device")

	def emptyline(self):
		pass

	do_EOF = do_exit
	help_EOF = help_exit

# The options the tool takes, in getopt's form: a ':' marks one that takes a
# value. report_bad_option() reads the same string to find the word a stray
# dash came from, so there is one copy for the two of them.
SHORT_OPTIONS = "f:b:U:h"

USAGE = ("Usage: ubertooth-btbr [-U <index|serial>] [-f <freq_offset>] "
	"[-b <max_ac_errors>]\n"
	"Options:\n"
	"  -U <index|serial>: select Ubertooth by index or serial; "
	"see ubertooth(7)\n"
	"  -f freq_offset: Set MOD_OFFSET register\n"
	"  -b max_ac_errors: Max bit errors in Syncword detection\n"
	"  -h: print this help\n")

def usage():
	"""The usage text for -h: standard output, and the tool is done."""
	sys.stdout.write(USAGE)
	sys.exit(0)

def dash_word(words, short_options):
	"""The option word a stray '-' came from, as the user wrote it.

	getopt reports the letter it rejected and not the word it was in, so the
	word is found by asking getopt again, one word longer each time: the
	first command line that ends in a rejected '-' ends in the word that
	holds it. Another refusal on the way (a missing value the next word will
	supply) is not it. None means no word produced one, which leaves the
	caller to name the dash alone.
	"""
	for length in range(1, len(words) + 1):
		try:
			getopt(words[:length], short_options)
		except GetoptError as refusal:
			if refusal.opt == '-':
				return words[length - 1]
	return None

def report_bad_option(refusal, short_options):
	"""Report a command line getopt would not take, as the other tools do.

	One line naming what is wrong, and no usage text: the user can run -h.
	getopt's own messages name the option but not what the tools call the
	problem, so they are rewritten here.
	"""
	# getopt says "option --name ..." for a word starting with two dashes
	# and "option -c ..." for a single letter. No tool takes long options.
	long_option = refusal.msg.startswith("option --")
	# A stray dash in an option word ("-h-") is rejected as the letter '-',
	# which reads as a long option here, so it is taken first: the word the
	# user wrote is what names it, as in the C tools.
	dash = (dash_word(sys.argv[1:], short_options)
		if refusal.opt == '-' else None)
	if refusal.msg.endswith("requires argument"):
		error("option '-%s' requires a value"%refusal.opt)
	elif refusal.opt == '-':
		error("unrecognized option '-' in '%s'"%dash if dash
			else "unrecognized option '-'")
	elif long_option:
		error("unrecognized option '--%s': the tools take "
			"single-letter options"%refusal.opt)
	else:
		error("unrecognized option '-%s'"%refusal.opt)
	sys.exit(1)

def leave(bt, status):
	"""Exit with no thread left inside libusb.

	The receive thread is a daemon, so the interpreter will not wait for it,
	and taking libusb down while that thread is inside a bulk read is how an
	exit becomes an abort. Stopping it first costs one read timeout. A thread
	that will not come out is reported by close(), which then leaves the
	handle alone.
	"""
	if bt is not None and bt.connected():
		bt.close()
	sys.exit(status)

def main():
	try:
		opt, args = getopt(sys.argv[1:], SHORT_OPTIONS)
	except GetoptError as e:
		report_bad_option(e, SHORT_OPTIONS)

	# Read before the device is opened, so a command line that is wrong is
	# refused without touching a board, and says what is wrong with it rather
	# than reporting whatever the board did first.
	# Both go into a request as 16 bits, so a value outside that is refused
	# here rather than reaching the packing and raising from there.
	settings = []
	selectors = []
	help_wanted = False
	for o, v in opt:
		if o == '-h':
			# Takes effect once the whole command line has parsed, as in the
			# other tools, so a bad value or a stray word is still reported.
			help_wanted = True
			continue
		if o == '-U':
			# Checked for repeats below, where the other tools check theirs.
			selectors.append(v)
			continue
		try:
			value = int(v)
		except ValueError:
			value = None
		if value is None or value < 0 or value > 0xffff:
			error("%s must be 0-65535 (got %s)"%(o, v))
			sys.exit(1)
		settings.append((o, value))
	if args:
		error("unexpected argument '%s'"%args[0])
		sys.exit(1)

	# An option given a value twice is two answers to one question, and the
	# tool does not pick between them. The wording is the one every tool
	# uses, from opt_check_once() in the C tools. Checked before -h ends the
	# command, like the other faults above: the C tools refuse the repeat as
	# they read the command line, so -h does not excuse it there either.
	given = ['-U'] * len(selectors) + [o for o, value in settings]
	for o in ('-U', '-f', '-b'):
		if given.count(o) > 1:
			error("option '%s' given more than once"%o)
			sys.exit(1)
	if help_wanted:
		usage()
	selector = selectors[0] if selectors else None

	bt = None
	try:
		bt = BTCtl.find(selector)
		bt.connect()

		for o, value in settings:
			if o == '-f':
				bt.send_set_freq_off_cmd(value)
			elif o == '-b':
				bt.send_set_max_ac_errors_cmd(value)

		bt.send_set_bdaddr_cmd(0x112233445566)
		eir = BTCtlEIR([
			(BTCtlEIR.EIR_COMPLETE_LOCAL_NAME, b"Ubertooth"),
		])
		bt.send_set_eir_cmd(eir.pack())
		sleep(0.02)
	except BTCtlNoDeviceError as e:
		error(e)
		sys.exit(1)
	except (usb1.USBError, BTCtlError) as e:
		# A board running firmware other than ubtbr takes none of this, and
		# used to leave the tool waiting on the write forever.
		#
		# Named by serial, because the usual cause is the wrong board rather
		# than a bad one: the serial says which board the session got, which
		# the user can compare with the one they flashed btbr onto.
		error("could not set up %s: %s"%(bt.board(), e))
		if isinstance(e, usb1.USBErrorTimeout):
			# The bluetooth_rxtx firmware offers the endpoint this tool
			# writes to but never reads it, so a request sits there until the
			# write times out. That is what every report of the tool hanging
			# shortly after start has turned out to be. A board already
			# carrying btbr that stopped answering times out the same way,
			# which is why this names what that firmware does rather than
			# telling the user what their board has.
			eprint("note: a board carrying bluetooth_rxtx never reads these "
				"requests; flash btbr with "
				"ubertooth-dfu -d firmware/btbr/btbr.dfu -r\n")
		leave(bt, 1)
	except KeyboardInterrupt:
		# Interrupted anywhere before the prompt was up, which is the window
		# the hang shortly after start lives in.
		leave(bt, 1)
	prompt = BTCtlPrompt(bt)
	prompt.cmdloop()
	if prompt.abandoned():
		# The session ended with the device still claimed by a command that
		# would not stop, so it did not do all it was asked. Out without the
		# interpreter's own teardown: that command may still be inside
		# libusb, and taking the library down under it is what turns an exit
		# into an abort. Nothing is buffered past the flushes.
		sys.stdout.flush()
		sys.stderr.flush()
		os._exit(1)

if __name__ == '__main__':
	# What main() decided, kept so that a standard output found gone below
	# can still raise it: -h and the refusals all leave through sys.exit().
	status = 0
	try:
		main()
	except SystemExit as leaving:
		status = leaving.code or 0
	except BrokenPipeError:
		# A write that was not a packet: the prompt, the intro, the usage
		# text and what `?` prints all go to standard output too, and
		# result() is the only one that notices the stream going away by
		# itself. A command line the tool refuses is the reachable case,
		# since it writes before anything else does.
		output_lost()
		# Out without the interpreter's own teardown, for the reason the
		# command that would not stop takes that way out: the receive thread
		# may be inside libusb, and taking the library down under it is what
		# turns an exit into an abort. Whatever is still buffered for the
		# stream that failed goes with it, which is where it was headed.
		sys.stderr.flush()
		os._exit(1)
	finally:
		# The last word on that stream, while a handler can still reach the
		# failure: the interpreter flushes it as it exits, outside any
		# handler, and a flush that fails there ends the tool in status 120
		# and a message of its own. Under `finally`, so that an exception on
		# the way out of main() does not leave that flush to the
		# interpreter. CPython's input() hides the same failure while
		# printing the prompt, so a session whose reader left can get this
		# far with the break unnoticed.
		try:
			sys.stdout.flush()
		except BrokenPipeError:
			output_lost()
		except (AttributeError, ValueError):
			# There is no standard output to flush: a descriptor closed
			# before the tool started leaves the interpreter without one.
			pass
	# A standard output that went away means what was asked for was not all
	# printed, whatever main() made of the rest.
	sys.exit(1 if output_gone() else status)
